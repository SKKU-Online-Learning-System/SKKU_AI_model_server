ARG BASE_IMAGE=runpod/pytorch:1.1.0-cu1281-torch280-ubuntu2404-cluster
FROM ghcr.io/astral-sh/uv:0.10.0 AS uvbin
FROM ${BASE_IMAGE}

COPY --from=uvbin /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY llm_runtime/pyproject.toml /app/llm_runtime/
RUN uv sync --project /app/llm_runtime --no-dev

COPY scripts/start_text_llm.sh scripts/start_voice_llm.sh /app/scripts/
RUN chmod +x /app/scripts/start_text_llm.sh /app/scripts/start_voice_llm.sh
