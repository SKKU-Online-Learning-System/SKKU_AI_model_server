ARG BASE_IMAGE=runpod/pytorch:1.1.0-cu1281-torch280-ubuntu2404-cluster
FROM ghcr.io/astral-sh/uv:0.10.0 AS uvbin
FROM ${BASE_IMAGE}

COPY --from=uvbin /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ffmpeg libsndfile1 sox libsox-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY speech_server/pyproject.toml /app/speech_server/
RUN uv sync --project /app/speech_server --no-dev

COPY speech_server /app/speech_server
COPY scripts/start_speech.sh /app/scripts/start_speech.sh
RUN chmod +x /app/scripts/start_speech.sh

CMD ["/app/scripts/start_speech.sh"]
