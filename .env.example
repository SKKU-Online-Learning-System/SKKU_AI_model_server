# Runtime paths
HF_HOME=${HOME}/.cache/huggingface
MODEL_SERVER_HOST=0.0.0.0

# Text LLM: physical GPU 0,1,2,3 / TP=4
TEXT_MODEL=Qwen/Qwen3.8-27B
TEXT_PORT=8001
TEXT_GPU_IDS=0,1,2,3
TEXT_TENSOR_PARALLEL_SIZE=4
TEXT_MAX_MODEL_LEN=16384
TEXT_MAX_NUM_SEQS=32
TEXT_GPU_MEMORY_UTILIZATION=0.90
TEXT_LANGUAGE_MODEL_ONLY=true
TEXT_DISABLE_CUSTOM_ALL_REDUCE=true

# Voice LLM: physical GPU 4
VOICE_MODEL=Qwen/Qwen3.5-9B
VOICE_PORT=8002
VOICE_GPU_IDS=4
VOICE_MAX_MODEL_LEN=8192
# Qwen3.5 is a hybrid attention/Mamba model. Keep this below the Mamba cache
# capacity available on the RTX A5000; 32 is ample for the single-user dev server.
VOICE_MAX_NUM_SEQS=32
VOICE_GPU_MEMORY_UTILIZATION=0.88
VOICE_LANGUAGE_MODEL_ONLY=true

# Speech: ASR + TTS share physical GPU 5
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
# Backend.AI에서 preopen port를 8001, 8002, 8010만 사용하는 구성입니다.
# ASR/TTS를 같은 Speech API에 노출해 네 번째 공개 포트가 필요하지 않습니다.
SPEECH_TTS_ENABLED=true
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
SPEECH_PORT=8010
SPEECH_GPU_ID=5
ASR_MAX_NEW_TOKENS=512
MAX_AUDIO_BYTES=52428800

# Empty means authentication disabled for local development.
MODEL_SERVER_API_KEY=
HF_TOKEN=
MODEL_SERVER_VERBOSE=false

# start_all.sh waits for actual API readiness, not only process creation.
MODEL_SERVER_STARTUP_TIMEOUT_SECONDS=900

# Optional process-management overrides. Empty values use <repo>/.run and <repo>/logs.
MODEL_SERVER_RUN_DIR=
MODEL_SERVER_LOG_DIR=

TTS_LANGUAGE=Auto
TTS_SPEAKER=Sohee
# Uses FlashAttention 2 when available and automatically falls back to SDPA.
TTS_ATTENTION_BACKEND=flash_attention_2

# 별도 8012 TTS는 선택 사항입니다. 3-port Backend.AI 구성에서는 끕니다.
QWEN_TTS_ENABLED=false
# "voice_clone" keeps the timbre stable across the several TTS requests one turn
# is split into by conditioning each on the same recording; a CustomVoice speaker
# id drifts audibly between requests. "custom_voice" selects one of the model's
# nine built-in timbres instead and needs a *-CustomVoice model.
QWEN_TTS_MODE=voice_clone
# Required when QWEN_TTS_MODE=voice_clone. REF_TEXT must be the exact transcript
# of REF_WAV. Voice reference audio is deployment data and must not be committed.
QWEN_TTS_REF_WAV=/home/work/workspace/SKKU_AI_model_server/samples/qwen_ryan_reference.wav
QWEN_TTS_REF_TEXT="안녕하세요. 오늘은 운영체제의 가상 메모리에 대해 함께 살펴보겠습니다. 천천히 설명드리니 편하게 들어주세요."
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_TTS_PORT=8012
QWEN_TTS_SPEAKER=ryan
QWEN_TTS_LANGUAGE=Auto
QWEN_TTS_ATTENTION_BACKEND=sdpa
# Frames per streaming chunk at 12 Hz; 4 measured best for RTF.
QWEN_TTS_CHUNK_SIZE=4
# Model default. Lower values destabilise the talker (silent or runaway
# outputs on short input) rather than calming it.
QWEN_TTS_TEMPERATURE=0.9
# Optional free-form delivery instruction, e.g.
#   QWEN_TTS_INSTRUCT="차분하고 담담한 톤으로 일정한 속도로 읽어줘."
# Costs about 180ms of first-packet latency.
QWEN_TTS_INSTRUCT=
# Exact tempo multiplier: 1.0 normal, 1.2 20% faster, 0.85 15% slower.
# Uses FFmpeg atempo so pitch is preserved. Supported range: 0.5-2.0.
QWEN_TTS_SPEED=1.0
# Trim the model's ~0.9s of leading/trailing silence. 0 disables.
QWEN_TTS_SILENCE_THRESHOLD=200
QWEN_TTS_SILENCE_PREROLL_MS=20
# Trailing silence kept so a clause-boundary seam keeps its pause.
QWEN_TTS_SILENCE_KEEP_MS=120
# Loudness every request is normalised towards, so consecutive requests in
# one turn do not step in level. 0 disables.
QWEN_TTS_TARGET_RMS_DBFS=-20
